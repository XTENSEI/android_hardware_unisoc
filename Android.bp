// Every HAL in this tree, so a product inherits one name
phony {
    name: "unisoc_hal",
    required: [
        "android.hardware.light-service.unisoc",
        "android.hardware.memtrack-service.unisoc",
        "android.hardware.vibrator-service.unisoc",
    ],
}
